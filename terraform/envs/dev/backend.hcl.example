# Copy to backend.hcl (git-ignored) and fill in. Never commit real values.
# The state bucket should have versioning, SSE-KMS and Block Public Access enabled.
bucket       = "<state-bucket-name>"
key          = "request-capture/dev/terraform.tfstate"
region       = "<region>"
encrypt      = true
use_lockfile = true # S3 native state locking (Terraform >= 1.10), no DynamoDB table needed
